{
  "openapi": "3.0.3",
  "info": {
    "title": "AgniAI API",
    "description": "REST API for AgniAI — Offline Agniveer Chatbot with RAG pipeline and Admin intelligence layer.\n\n## User APIs\nChat with the Agniveer knowledge base, ingest documents, manage sessions.\n\n## Admin APIs\nNatural-language queries that route through the .NET AiCommand backend for structured data (Performance, Leave, Medical, Attendance, Verification, Equipment, Distribution, Skills).",
    "version": "1.0.0",
    "contact": {
      "name": "AgniAI"
    }
  },
  "servers": [],
  "tags": [
    {
      "name": "System",
      "description": "Health and readiness checks"
    },
    {
      "name": "Chat",
      "description": "User-facing RAG chatbot"
    },
    {
      "name": "Knowledge Base",
      "description": "Ingest and manage documents"
    },
    {
      "name": "Session",
      "description": "Conversation memory management"
    },
    {
      "name": "Admin Chat",
      "description": "Admin intelligence chatbot (routes through .NET)"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health check",
        "description": "Returns Ollama connectivity status, vector count, chunk count and active model.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Ollama is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Readiness check",
        "description": "Returns whether the embedding model and FAISS index have finished warming up.",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {}
            }
          },
          "503": {
            "description": "Still warming up",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Chat (RAG)",
        "description": "Send a message to the AgniAI chatbot. Automatically classifies intent (chat / RAG / reject), retrieves relevant chunks from FAISS+BM25, and generates a grounded answer via Ollama.\n\n**Streaming:** Set `stream: true` and include header `Accept: text/event-stream` for SSE token streaming.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/api/ingest": {
      "post": {
        "tags": [
          "Knowledge Base"
        ],
        "summary": "Ingest a document by path or URL",
        "description": "Add a PDF, URL, plain text file, raw text string, or Word document to the FAISS knowledge base.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ingestion result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/upload": {
      "post": {
        "tags": [
          "Knowledge Base"
        ],
        "summary": "Upload and ingest a file",
        "description": "Upload a file via multipart/form-data. Supported types: `pdf`, `txt`, `docx`. The file is saved to a temp path, ingested, then deleted.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The file to upload (pdf / txt / docx)"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "pdf",
                      "txt",
                      "docx"
                    ],
                    "description": "Optional override for file type detection"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File ingested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "415": {
            "description": "Unsupported file type",
            "content": {
              "application/json": {}
            }
          },
          "422": {
            "description": "File has no extractable text",
            "content": {
              "application/json": {}
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/sources": {
      "get": {
        "tags": [
          "Knowledge Base"
        ],
        "summary": "List ingested sources",
        "description": "Returns all sources currently in the knowledge base with chunk counts and document types.",
        "responses": {
          "200": {
            "description": "Source list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourcesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": [
          "Knowledge Base"
        ],
        "summary": "Index statistics",
        "description": "Returns the total number of vectors in FAISS and chunks in the docstore.",
        "responses": {
          "200": {
            "description": "Stats",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/clear_memory": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Clear conversation memory",
        "description": "Clears the sliding-window conversation history for the given session. Omit `session_id` to clear the default session.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Memory cleared",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/reset_index": {
      "post": {
        "tags": [
          "Knowledge Base"
        ],
        "summary": "⚠️ Reset entire knowledge base",
        "description": "**DESTRUCTIVE** — Deletes the FAISS index, docstore, and BM25 index. All ingested documents are lost.\n\nRequires `X-Api-Key` header if `API_SECRET_KEY` is set in `.env`.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Index reset",
            "content": {
              "application/json": {}
            }
          },
          "401": {
            "description": "Unauthorized — wrong or missing API key",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/admin/health": {
      "get": {
        "tags": [
          "Admin Chat"
        ],
        "summary": "Admin subsystem health",
        "description": "Checks whether the .NET AiCommand backend at `DOTNET_API_BASE_URL` is reachable.",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/admin/classify": {
      "post": {
        "tags": [
          "Admin Chat"
        ],
        "summary": "Classify admin intent (debug)",
        "description": "Runs the intent classifier and returns the structured JSON payload — **without** calling the .NET backend. Use this to debug how a question is being interpreted before wiring up .NET.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminClassifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Intent classification result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminClassifyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/admin/chat": {
      "post": {
        "tags": [
          "Admin Chat"
        ],
        "summary": "Admin chat",
        "description": "Full admin pipeline:\n1. Classify intent → structured JSON\n2. POST to `.NET /api/AiCommand/execute`\n3. Format response → human-readable answer\n\n**Supported modules:** Performance, Leave, Medical, Attendance, Verification, Equipment, Distribution, Skills/Roster",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Formatted answer from .NET data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminChatResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          },
          "502": {
            "description": "Bad gateway — .NET backend error or unreachable",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "Required only for /api/reset_index when API_SECRET_KEY is set in .env"
      }
    },
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "User question"
          },
          "model": {
            "type": "string",
            "description": "Ollama model override"
          },
          "stream": {
            "type": "boolean",
            "description": "Enable SSE streaming (requires Accept: text/event-stream header)",
            "default": false
          },
          "session_id": {
            "type": "string",
            "description": "Session identifier for conversation memory"
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "answer": {
            "type": "string",
            "description": "The generated answer"
          },
          "style": {
            "type": "string",
            "enum": [
              "short",
              "elaborate",
              "detail"
            ],
            "description": "Answer style detected from the query"
          },
          "session_id": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "IngestRequest": {
        "type": "object",
        "required": [
          "kind",
          "target"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "pdf",
              "url",
              "txt",
              "text",
              "docx"
            ]
          },
          "target": {
            "type": "string",
            "description": "File path, URL, or raw text content"
          }
        }
      },
      "IngestResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "chunks": {
            "type": "integer",
            "description": "Number of new chunks added"
          },
          "source": {
            "type": "string",
            "description": "Normalised source identifier"
          }
        }
      },
      "SourcesResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "count": {
            "type": "integer"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "doc_type": {
                  "type": "string",
                  "enum": [
                    "pdf",
                    "url",
                    "txt",
                    "text",
                    "docx"
                  ]
                },
                "chunk_count": {
                  "type": "integer"
                },
                "original_filename": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "ollama_unreachable"
            ]
          },
          "vectors": {
            "type": "integer"
          },
          "chunks": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          }
        }
      },
      "AdminChatRequest": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          }
        }
      },
      "AdminChatResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean"
          },
          "introMessage": {
            "type": "object"
          },
          "formattedData": {
            "type": "object"
          },
          "analysis": {
            "type": "object"
          },
          "prediction": {
            "type": "object"
          },
          "conclusion": {
            "type": "object"
          },
          "suggestedQuestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "widgets": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "metadata": {
            "type": "object"
          },
          "overallConfidence": {
            "type": "number"
          },
          "partialFailure": {
            "type": "boolean"
          },
          "failedSections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AdminClassifyRequest": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "AdminClassifyResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "intent": {
            "$ref": "#/components/schemas/FrontendIntent"
          },
          "dotnet_payload": {
            "$ref": "#/components/schemas/DotnetPayload"
          }
        }
      },
      "IntentResult": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "nullable": true,
            "description": "Module: Performance | Leave | Medical | Attendance | Verification | Equipment | Distribution | Skills"
          },
          "subcategory": {
            "type": "string",
            "nullable": true,
            "description": "Intent code sent to .NET"
          },
          "number": {
            "type": "integer",
            "nullable": true,
            "description": "Extracted count (top N / bottom N)"
          },
          "operation": {
            "type": "string",
            "nullable": true,
            "description": "Extracted operation keyword"
          },
          "section": {
            "type": "string",
            "nullable": true,
            "description": "Section filter: BEPT | PPT | FIRING | DRILL"
          },
          "grading": {
            "type": "string",
            "nullable": true,
            "description": "Grading filter: ExceptionallyWell | Excellent | Good | SAT | Fail | UNSA"
          },
          "leave_type": {
            "type": "string",
            "nullable": true,
            "description": "Leave type: Medical | Annual | Sick | Absconded"
          },
          "type": {
            "type": "string",
            "nullable": true,
            "description": "Frontend widget type: Tabular | Bar Chart | Trend Chart | Area Chart | Donut Chart | Pie Chart | Radial Chart | Calendar UI | Card"
          },
          "raw_query": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      },
      "FrontendIntent": {
        "type": "object",
        "description": "Frontend-facing intent view (request fields plus visual type)",
        "properties": {
          "commandId": {
            "type": "integer",
            "default": 0
          },
          "category": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "subSection": {
            "type": "string"
          },
          "grading": {
            "type": "string"
          },
          "attemptNo": {
            "type": "integer"
          },
          "fromAttempt": {
            "type": "integer"
          },
          "toAttempt": {
            "type": "integer"
          },
          "leaveType": {
            "type": "string"
          },
          "bmiCategory": {
            "type": "string"
          },
          "bloodGroup": {
            "type": "string"
          },
          "equipmentName": {
            "type": "string"
          },
          "n": {
            "type": "integer"
          },
          "batchId": {
            "type": "integer"
          },
          "platoonId": {
            "type": "integer"
          },
          "unitName": {
            "type": "string"
          },
          "agniveerNo": {
            "type": "string"
          },
          "companyId": {
            "type": "integer"
          },
          "sport": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "fromDate": {
            "type": "string",
            "format": "date-time"
          },
          "toDate": {
            "type": "string",
            "format": "date-time"
          },
          "medicalStatus": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Frontend widget type"
          }
        }
      },
      "DotnetPayload": {
        "type": "object",
        "description": "Payload sent to .NET /api/AiCommand/execute (null fields stripped)",
        "properties": {
          "commandId": {
            "type": "integer",
            "default": 0
          },
          "category": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "subSection": {
            "type": "string"
          },
          "grading": {
            "type": "string"
          },
          "attemptNo": {
            "type": "integer"
          },
          "fromAttempt": {
            "type": "integer"
          },
          "toAttempt": {
            "type": "integer"
          },
          "leaveType": {
            "type": "string"
          },
          "bmiCategory": {
            "type": "string"
          },
          "bloodGroup": {
            "type": "string"
          },
          "equipmentName": {
            "type": "string"
          },
          "n": {
            "type": "integer"
          },
          "batchId": {
            "type": "integer"
          },
          "platoonId": {
            "type": "integer"
          },
          "unitName": {
            "type": "string"
          },
          "agniveerNo": {
            "type": "string"
          },
          "companyId": {
            "type": "integer"
          },
          "sport": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "fromDate": {
            "type": "string",
            "format": "date-time"
          },
          "toDate": {
            "type": "string",
            "format": "date-time"
          },
          "medicalStatus": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "groupBy": {
            "type": "string"
          },
          "analyticsHint": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "nullable": true
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request — missing or invalid fields",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "File not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RateLimit": {
        "description": "Rate limit exceeded",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "LLM service unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}